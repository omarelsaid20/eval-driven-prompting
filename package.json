{
  "name": "handover-note",
  "version": "0.1.0",
  "description": "Drafts an internal handover note for a support ticket that Reply Assist escalated.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "run:eval": "tsx --env-file=.env src/run.ts",
    "score": "tsx src/score.ts",
    "check": "tsx scripts/check-render.ts && tsx scripts/check-schema.ts",
    "tokens": "tsx --env-file=.env scripts/count-tokens.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
